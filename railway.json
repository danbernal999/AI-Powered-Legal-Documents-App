{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "buildCommand": "docker build -f backend/Dockerfile -t app:latest ./backend"
  },
  "deploy": {
    "startCommand": "cd /app && ./main",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30
  }
}
